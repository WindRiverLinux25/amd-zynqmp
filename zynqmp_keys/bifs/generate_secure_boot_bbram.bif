//arch = zynqmp; split = false; format = BIN
the_ROM_image:
{
	[keysrc_encryption] bbram_red_key
	[bootloader, encryption = aes, aeskeyfile=<path_to_place_nky>/aes0.nky] fsbl.elf
	[destination_cpu=pmu] pmufw.elf
	[encryption = aes, aeskeyfile=<path_to_place_nky>/aes1.nky, destination_device = pl] <your_bitstream_file>
	[encryption = aes, aeskeyfile=<path_to_place_nky>/aes2.nky, destination_cpu = a53-0, exception_level = el-3, trustzone] arm-trusted-firmware.elf
	[encryption = aes, aeskeyfile=<path_to_place_nky>/aes3.nky, destination_cpu = a53-0, load = 0x100000] <your_dtb_file>
	[encryption = aes, aeskeyfile=<path_to_place_nky>/aes4.nky, destination_cpu = a53-0, exception_level = el-2] u-boot.elf
}
