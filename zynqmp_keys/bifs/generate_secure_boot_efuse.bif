//arch = zynqmp; split = false; format = BIN
the_ROM_image:
{
	[keysrc_encryption] efuse_red_key
	[pskfile] <path_to_place_keys>/psk0.pem
	[sskfile] <path_to_place_keys>/ssk0.pem
	[auth_params] ppk_select=0; spk_id=0x12345678
	[bootloader, destination_cpu=a53-0, authentication=rsa, encryption=aes, aeskeyfile=<path_to_place_nky>/aes0.nky] fsbl.elf
	[destination_cpu=pmu] ./recipe-sysroot/boot/pmufw.elf
	[authentication=rsa, encryption=aes, aeskeyfile=<path_to_place_nky>/aes1.nky, destination_device = pl] <your_bitstream_file>
	[authentication=rsa, encryption=aes, aeskeyfile=<path_to_place_nky>/aes2.nky, destination_cpu=a53-0, exception_level=el-3, trustzone] arm-trusted-firmware.elf
	[authentication=rsa, encryption=aes, aeskeyfile=<path_to_place_nky>/aes3.nky, destination_cpu=a53-0, load=0x100000] <your_dtb_file>
	[authentication=rsa, encryption=aes, aeskeyfile=<path_to_place_nky>/aes4.nky, destination_cpu=a53-0, exception_level=el-2] u-boot.elf
}
